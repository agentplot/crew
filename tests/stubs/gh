#!/usr/bin/env bash
# Stub gh for crew's tests: crew runs no gh command (crew-lands-each-bolt-through-flumes-base-place, Decision 1; bolt-teams
# "No crew command runs sluice, wt or gh for a bolt, or moves a checkout"), so every call is refused, exiting 2, and
# logged to $CREW_TEST_LOG as `<host> gh <args>`, which a test reads to find none; it stands first on the path so no
# test ever reaches the real gh and GitHub (tests.11).
[[ -n ${CREW_TEST_LOG:-} ]] && printf '%s gh %s\n' "${CREW_TEST_HOST:-?}" "$*" >> "$CREW_TEST_LOG"
echo "gh stub: crew runs no gh command, and gh $* is not stubbed" >&2
exit 2
